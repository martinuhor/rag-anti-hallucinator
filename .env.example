# ==============================================================================
# Multi-Model RAG & Hallucination Auditor Agent - Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Required - Free tier at https://aistudio.google.com)
# Powers the Critic / Auditor (gemini-2.5-flash / gemini-1.5-flash) and acts as
# automatic fallback generator if GROQ_API_KEY is not configured.
# Works with any standard Google/Gmail account.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. Groq API Key (Optional - High-speed LPU Generator: llama-3.3-70b-versatile)
# Sign up at: https://console.groq.com (use "Continue with GitHub" or a Gmail address)
# If omitted or signup is blocked, the agent automatically uses Google Gemini.
GROQ_API_KEY=

# Optional: Host and Port configuration for FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
